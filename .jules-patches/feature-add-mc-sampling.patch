Subject: [PATCH] fix: correct ISolver interface implementation

---
 CombinatorialOptimiser.Cli/Program.cs                        | 4 ++--
 src/CombinatorialOptimiser/Permutation/MCSamplingSolver.cs   | 13 ++++++++++---
 2 files changed, 12 insertions(+), 5 deletions(-)

diff --git a/CombinatorialOptimiser.Cli/Program.cs b/CombinatorialOptimiser.Cli/Program.cs
index d5a5700..81373da 100644
--- a/CombinatorialOptimiser.Cli/Program.cs
+++ b/CombinatorialOptimiser.Cli/Program.cs
@@ -72,7 +72,7 @@ void PrintHelp()
 }
 
 var argCities = 0; var argSeed = -1; string? argSolver = null; var showHelp = false;
-var argSeedChristofides = false;
+
 for (var i = 0; i < args.Length; i++)
 {
     switch (args[i])
@@ -83,7 +83,7 @@ for (var i = 0; i < args.Length; i++)
         case "--beam-temp" when i + 1 < args.Length: _ = double.TryParse(args[++i], NumberStyles.Float, CultureInfo.InvariantCulture, out argBeamTemp); argBeamEnabled = true; break;
         case "--beam-rank" when i + 1 < args.Length: argBeamRank = args[++i]; argBeamEnabled = true; break;
         case "--help": case "-h": showHelp = true; break;
-        case "--seed-christofides": argSeedChristofides = true; break;
+        
     }
 }
 if (showHelp) { PrintHelp(); return; }
diff --git a/src/CombinatorialOptimiser/Permutation/MCSamplingSolver.cs b/src/CombinatorialOptimiser/Permutation/MCSamplingSolver.cs
index 92c813a..fbdd190 100644
--- a/src/CombinatorialOptimiser/Permutation/MCSamplingSolver.cs
+++ b/src/CombinatorialOptimiser/Permutation/MCSamplingSolver.cs
@@ -12,14 +12,21 @@ namespace CombinatorialOptimiser.Permutation;
 /// </summary>
 public sealed class MCSamplingSolver : ISolver<DistanceMatrix, PermutationResult>
 {
+    /// <inheritdoc/>
+    public string Name => "Monte Carlo Sampling";
+    /// <inheritdoc/>
+    public SolverParadigm Paradigm => SolverParadigm.Construction;
+        /// <summary>Number of samples.</summary>
     public int Samples { get; init; } = 1000;
 
+        /// <inheritdoc/>
     public PermutationResult Solve(DistanceMatrix matrix)
     {
+        ArgumentNullException.ThrowIfNull(matrix);
         var n = matrix.Count;
         var rng = new Random(1234);
         var best = Enumerable.Range(0, n).ToArray();
-        var bestCost = matrix.TourCost(best);
+        var bestCost = matrix.TourLength(best);
 
         var arr = Enumerable.Range(0, n).ToArray();
         for (int s = 0; s < Samples; s++)
@@ -32,13 +39,13 @@ public sealed class MCSamplingSolver : ISolver<DistanceMatrix, PermutationResult
                 (arr[i], arr[j]) = (arr[j], arr[i]);
             }
 
-            var cost = matrix.TourCost(arr);
+            var cost = matrix.TourLength(arr);
             if (cost < bestCost)
             {
                 bestCost = cost;
                 best = arr.ToArray();
             }
         }
 
-        return new PermutationResult(best, bestCost);
+        return SolverRunner.Timed(Name, Paradigm, matrix, () => best);
     }
 }
