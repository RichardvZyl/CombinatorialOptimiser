+++ b/src/CombinatorialOptimiser/Permutation/GnnPolicySolver.cs
@@ -13,13 +13,20 @@ namespace CombinatorialOptimiser.Permutation;
 /// </summary>
 public sealed class GnnPolicySolver : ISolver<DistanceMatrix, PermutationResult>
 {
+    /// <inheritdoc/>
+    public string Name => "GNN Policy";
+    /// <inheritdoc/>
+    public SolverParadigm Paradigm => SolverParadigm.Construction;
     private readonly int _seed;
 
+        /// <summary>Constructor</summary>
     public GnnPolicySolver(int seed = 42) => _seed = seed;
 
+        /// <inheritdoc/>
     public PermutationResult Solve(DistanceMatrix matrix)
     {
         // Fallback: rank nodes by sum of outgoing distances (cheap centrality heuristic)
+        ArgumentNullException.ThrowIfNull(matrix);
         var n = matrix.Count;
         var scores = new double[n];
         for (int i = 0; i < n; i++)
@@ -30,6 +37,6 @@ public sealed class GnnPolicySolver : ISolver<DistanceMatrix, PermutationResult>
         }
 
         var order = scores.Select((s, i) => (s, i)).OrderByDescending(x => x.s).Select(x => x.i).ToArray();
-        return new PermutationResult(order, matrix.TourCost(order));
+        return SolverRunner.Timed(Name, Paradigm, matrix, () => order);
     }
 }
